# ---------------------------------------------------------------------------
# PawPort environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Do NOT commit the populated .env file — it is gitignored.
# ---------------------------------------------------------------------------

# --- Database (Requirement 22) ---
# MongoDB connection string used by the cached Mongoose connection singleton.
MONGODB_URI="mongodb://localhost:27017/pawport"

# --- Authentication / NextAuth.js (Requirement 1) ---
# Secret used to sign JWT sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# The canonical URL NextAuth uses for callbacks and redirects.
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Requirement 1) ---
# OAuth 2.0 client credentials for "Sign in with Google" (sign-in only).
# NOTE: PawPort's calendar is native + a read-only ICS feed (Master Spec §9).
# Google Calendar sync has been removed, so no Google Calendar / service-account
# variables are needed. These are used ONLY for sign-in and are optional.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- Stripe (Requirement 7) ---
# Server-side secret key (starts with sk_test_ / sk_live_).
STRIPE_SECRET_KEY="sk_test_replace_me"
# Webhook signing secret (starts with whsec_) used to verify incoming events.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Publishable key exposed to the browser (starts with pk_test_ / pk_live_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# --- Stripe Billing: subscription plans (Phase 5 — Master Spec §13.1, §13.2) ---
# Recurring Price ids (price_...) for each plan + interval, created in the
# Stripe dashboard (Products → add monthly + annual prices). Subscription
# billing degrades gracefully until ALL FOUR are set: the /billing page shows a
# clear "Billing isn't set up yet" state, checkout/portal return "not
# configured", and entitlement gating still works. Annual ≈ 2 months free.
STRIPE_PRICE_SOLO_MONTH="price_replace_me_solo_month"
STRIPE_PRICE_SOLO_YEAR="price_replace_me_solo_year"
STRIPE_PRICE_PRO_MONTH="price_replace_me_pro_month"
STRIPE_PRICE_PRO_YEAR="price_replace_me_pro_year"

# Billing webhook signing secret (whsec_...) for the SUBSCRIPTION endpoint
# /api/stripe/billing-webhook. Configure a SEPARATE endpoint in Stripe from the
# deposit webhook so they can be rotated independently. If unset, the billing
# webhook falls back to STRIPE_WEBHOOK_SECRET (fine for local/dev); if NEITHER
# is set the endpoint no-ops with 200.
STRIPE_BILLING_WEBHOOK_SECRET="whsec_replace_me_billing"

# Founding-member coupon seam (Master Spec §13.2). Optional: when a coupon id is
# present it is applied at checkout, otherwise it is skipped. Use the per-plan
# vars for different coupons, or the generic fallback for one shared coupon.
# Create coupons in Stripe with duration: forever for lifetime-locked pricing.
STRIPE_FOUNDING_COUPON_SOLO=""
STRIPE_FOUNDING_COUPON_PRO=""
STRIPE_FOUNDING_COUPON_ID=""

# --- Stripe Connect: client deposits to groomers (Phase 5 — Master Spec §13.3) ---
# Connect platform client id (ca_...) used for Express onboarding of groomers so
# deposits pay out to their own account. When unset, Connect onboarding returns
# "not configured" and the connect webhook no-ops — the existing deposit
# PaymentIntent flow is unaffected.
STRIPE_CONNECT_CLIENT_ID="ca_replace_me"
# Connect webhook signing secret (whsec_...) for /api/stripe/connect-webhook.
# Falls back to STRIPE_WEBHOOK_SECRET when unset (local/dev); no-op 200 when
# neither is configured.
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_replace_me_connect"

# --- File Uploads / UploadThing (Requirement 23) ---
UPLOADTHING_SECRET="sk_live_replace_me"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# --- Transactional Email (Requirement 8) ---
# Resend API key used to send booking confirmation + groomer notification emails.
RESEND_API_KEY="re_replace_me"
# Address confirmation emails are sent FROM and groomer notifications are sent TO.
BUSINESS_EMAIL="you@example.com"
# Business display name used in the email "from" header and templates.
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"

# --- Cron / Scheduled Jobs ---
# Shared secret required in the Authorization header of cron endpoints.
# (The Google Calendar sync cron has been removed; the native calendar needs no
# periodic sync. Retained for other scheduled jobs.) Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-cron-secret"

# --- App URLs ---
# Public base URL used to build shareable links (booking pages, pet cards).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Upstash Redis (Phase 2: slot holds, booking locks, availability cache, rate limiting, idempotency) ---
# Create a free Regional database at https://console.upstash.com and copy the REST API values.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# --- Twilio SMS (Phase 4: two-way texting, reminders, confirmations — Master Spec §4.3, §12) ---
# All THREE are required to actually send SMS. When any is missing, PawPort's
# SmsProvider degrades to a no-op-that-logs: everything still builds and runs,
# messages are logged to the Inbox, and the Inbox shows a "SMS not configured"
# read-only state. Add these once your Twilio A2P 10DLC brand/campaign is
# approved (registration takes time — start early, see Master Spec §12.4).
#
# Account SID + auth token from https://console.twilio.com (the auth token also
# verifies inbound + status-callback webhook signatures).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# Messaging Service SID (starts with MG). Sending goes through the messaging
# service so Twilio handles the sender pool. Status callbacks point at
# {NEXT_PUBLIC_APP_URL}/api/twilio/status; inbound at /api/twilio/inbound.
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Upstash QStash (Phase 4: scheduled appointment reminders — Master Spec §4.3, §12.3, §16) ---
# Used to schedule reminder_24h + reminder_2h jobs that call
# {NEXT_PUBLIC_APP_URL}/api/qstash/reminder at the right time. When QSTASH_TOKEN
# is absent, reminder scheduling degrades to a logged no-op (bookings still
# succeed); a Vercel-cron fallback that scans for due reminders is a documented
# seam (Master Spec §16) and is not built yet.
# Get these from https://console.upstash.com (QStash tab).
QSTASH_TOKEN="your-qstash-token"
# Signing keys used by the /api/qstash/reminder route to verify QStash requests.
QSTASH_CURRENT_SIGNING_KEY="sig_current_replace_me"
QSTASH_NEXT_SIGNING_KEY="sig_next_replace_me"

# --- SMS quota (Phase 4 seam) ---
# Included monthly SMS allowance per groomer used by the quota gate until the
# billing Subscription model (Phase 5) resolves it from the plan. Optional;
# defaults to 300 when unset (Master Spec §12.3, §13.1).
SMS_INCLUDED_DEFAULT="300"
